# ============================================================
# SLICNA Backend - Environment Variables
# ============================================================
# Copy this file to ".env" and fill in your actual local values.
# NEVER commit the real .env file -- it contains secrets.
# ============================================================

# --- Local PostgreSQL connection ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=slicna_db

# --- Server ---
# 3001 so it can run alongside the SLNA backend (which uses 3000).
PORT=3001

# --- CORS ---
# Comma-separated list of frontend origin(s) allowed to call this API from a
# browser (no trailing slash). Local dev (http://localhost:* and
# http://127.0.0.1:*) is always allowed.
CORS_ORIGIN=https://slicna.lk

# --- JWT (used to sign admin login tokens) ---
# Generate one with: node generate-secret.js
JWT_SECRET=replace_with_a_long_random_string

# --- Public website address (no trailing slash) ---
# Used to build links in emails (renewal links, status page).
SITE_URL=https://slicna.lk

# --- Email (Resend) ---
# Membership emails (application received/approved, renewal reminders) are
# sent through Resend. Leave RESEND_API_KEY empty to switch email off: the
# messages are then logged and skipped, and admins can copy renewal links
# from the admin panel instead. The sender domain must be verified in Resend.
EMAIL_ENABLED=true
RESEND_API_KEY=
MAIL_FROM="SLICNA <noreply@slicna.lk>"

# --- Secretary ---
# SECRETARY_EMAIL gets an email for every new membership application and
# every approval (one address, or several separated by commas). Its first
# address and SECRETARY_CONTACT_NO are the contact details shown to
# applicants on the status page and in emails when more information is
# needed or an application is rejected.
SECRETARY_EMAIL=secretary@example.com
SECRETARY_CONTACT_NO=0713385768
